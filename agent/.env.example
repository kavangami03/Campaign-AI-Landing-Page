# ─────────────────────────────────────────────────────────────
# 1. LiveKit  →  https://cloud.livekit.io  (Settings → Keys)
# ─────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# 2. Sarvam AI  →  https://dashboard.sarvam.ai  (Gujarati voice + ears)
#    New accounts get Rs.1000 free credit. No card needed.
# ─────────────────────────────────────────────────────────────
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Which Gujarati voice speaks. Female: shruti, kavya, priya, neha, ishita
#                              Male:   shubh, aditya, rohan, dev, varun
SARVAM_SPEAKER=priya

# Voice tuning. temperature = expressiveness (0.6 flat/robotic, 0.85 human,
# 1.1+ glitchy).  pace = speed (0.9 slow & calm, 1.0 normal).
SARVAM_TEMPERATURE=0.85
SARVAM_PACE=0.97

# ─────────────────────────────────────────────────────────────
# 3. Google Gemini  →  https://aistudio.google.com/apikey  (the brain, free)
# ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Gemini model thinks. gemini-3.6-flash is newest+fastest.
# Alternatives: gemini-3.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash-lite

# ─────────────────────────────────────────────────────────────
# 4. SMTP  →  where leads get emailed
#    Gmail: turn on 2-Step Verification, then create an App Password
#           at https://myaccount.google.com/apppasswords
#           Use that 16-character password below, NOT your login password.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kavan.gami@softqubes.com
SMTP_PASSWORD=pqcebhmffwrdxnjj

# Who receives the leads. Leave blank to send to SMTP_USER.
LEAD_TO_EMAIL=kavan.gami@softqubes.com

# ─────────────────────────────────────────────────────────────
# 5. Voice engine choice:  sarvam | elevenlabs | cartesia
# ─────────────────────────────────────────────────────────────
TTS_PROVIDER=cartesia

# ElevenLabs → https://elevenlabs.io  (best quality; free tier is
# non-commercial, Starter ~$5/mo for commercial use)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # Sarah
ELEVEN_MODEL=eleven_multilingual_v2   # v3 cannot stream

# Cartesia → https://cartesia.ai  (fastest; free tier non-commercial)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=4590a461-bc68-4a50-8d14-ac04f5923d22   # Isha

# Voice tuning. volume 0.5-2.0 (1.5 = clearly louder).
# speed 0.6-2.0 (0.95 = relaxed). emotion = comma separated.
CARTESIA_VOLUME=1.5
CARTESIA_SPEED=0.95
CARTESIA_EMOTION=Happy,Curious
# Emotion used only for questions, so they rise instead of
# trailing off like a statement.
CARTESIA_QUESTION_EMOTION=Curious,Anticipation

# ─────────────────────────────────────────────────────────────
# OpenAI → https://platform.openai.com/api-keys  (the brain)
#   Paid only — no free tier. Add credit at platform.openai.com/billing
#   gpt-4o costs roughly $2.50 per 1M input tokens.
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
